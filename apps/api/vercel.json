{
  "framework": null,
  "buildCommand": "npm run build",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "../../packages/contracts/dist/**/*.js"
    }
  },
  "rewrites": [
    { "source": "/v1/:path*", "destination": "/api/index?__agenda_path=/v1/:path*" }
  ]
}
