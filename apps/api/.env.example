# Supabase project URL, for example https://YOUR_PROJECT.supabase.co
SUPABASE_URL=
# Server-side secret key only. Never expose it to the browser or mobile app.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated origins allowed to call the API (include https://localhost for Capacitor Android)
ALLOWED_ORIGINS=https://localhost
PORT=3333
HOST=0.0.0.0
