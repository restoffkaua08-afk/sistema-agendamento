# API / Supabase PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/postgres
DATABASE_SSL=require
SESSION_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGINS=https://your-site.vercel.app

# Public web -> API Vercel project
NEXT_PUBLIC_API_URL=https://your-api.vercel.app
NEXT_PUBLIC_TENANT_SLUG=marca
NEXT_PUBLIC_TENANT_NAME=Marca

# Capacitor release sync: point to the owner panel
MOBILE_WEB_URL=https://your-site.vercel.app/painel

# First tenant bootstrap
TENANT_SLUG=marca
TENANT_NAME=Marca
TENANT_TIMEZONE=America/Sao_Paulo
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-before-running
ADMIN_NAME=Administrador
